# Bind only to loopback by default. Change explicitly to expose beyond this machine.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Local processed-data directory. Must contain ful116/imerg_2005_point_snapshot.json
# to serve the verified 12-month IMERG point series. The container mounts it read-only.
ANOMALY_ZERO_PROCESSED_DIR=./data/processed
